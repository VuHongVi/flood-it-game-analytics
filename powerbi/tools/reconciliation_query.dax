EVALUATE
VAR t = UNION (
ROW ( "check_id", 1, "measure", "[Players in Window] | none", "expected", 15175, "actual", CALCULATE ( [Players in Window] ), "tol", 0 ),
ROW ( "check_id", 2, "measure", "[Cohort Installs] | all cohort_week", "expected", 4307, "actual", CALCULATE ( [Cohort Installs] ), "tol", 0 ),
ROW ( "check_id", 3, "measure", "[Avg DAU excl Spikes] | all dates", "expected", 471.4, "actual", CALCULATE ( [Avg DAU excl Spikes] ), "tol", 0.05 ),
ROW ( "check_id", 4, "measure", "[Avg DAU] | all dates", "expected", 517.9, "actual", CALCULATE ( [Avg DAU] ), "tol", 0.05 ),
ROW ( "check_id", 5, "measure", "[Avg Stickiness Clean] | all dates", "expected", 0.0986, "actual", CALCULATE ( [Avg Stickiness Clean] ), "tol", 0.0001 ),
ROW ( "check_id", 6, "measure", "[Retention D1] | all cohort_week", "expected", 0.2147, "actual", CALCULATE ( [Retention D1] ), "tol", 0.0001 ),
ROW ( "check_id", 7, "measure", "[Retention D3] | all cohort_week", "expected", 0.1044, "actual", CALCULATE ( [Retention D3] ), "tol", 0.0001 ),
ROW ( "check_id", 8, "measure", "[Retention D7] | all cohort_week", "expected", 0.0554, "actual", CALCULATE ( [Retention D7] ), "tol", 0.0001 ),
ROW ( "check_id", 9, "measure", "[Retention D14] | all cohort_week", "expected", 0.0362, "actual", CALCULATE ( [Retention D14] ), "tol", 0.0001 ),
ROW ( "check_id", 10, "measure", "[Retention D30] | all cohort_week", "expected", 0.021, "actual", CALCULATE ( [Retention D30] ), "tol", 0.0001 ),
ROW ( "check_id", 11, "measure", "[Retention by Platform] | platform=ANDROID, day_n=1", "expected", 0.2269, "actual", CALCULATE ( [Retention by Platform], dim_platform[platform] = "ANDROID", fact_retention_platform[day_n] = 1 ), "tol", 0.0001 ),
ROW ( "check_id", 12, "measure", "[Retention by Platform] | platform=IOS, day_n=1", "expected", 0.1895, "actual", CALCULATE ( [Retention by Platform], dim_platform[platform] = "IOS", fact_retention_platform[day_n] = 1 ), "tol", 0.0001 ),
ROW ( "check_id", 13, "measure", "[Installs] | all dates", "expected", 4319, "actual", CALCULATE ( [Installs] ), "tol", 0 ),
ROW ( "check_id", 14, "measure", "[Spike Days] | all dates", "expected", 7, "actual", CALCULATE ( [Spike Days] ), "tol", 0 ),
ROW ( "check_id", 15, "measure", "[Revenue USD] | all platforms", "expected", 31.86, "actual", CALCULATE ( [Revenue USD] ), "tol", 0.005 ),
ROW ( "check_id", 16, "measure", "[Payers] | all platforms", "expected", 27, "actual", CALCULATE ( [Payers] ), "tol", 0 ),
ROW ( "check_id", 17, "measure", "[Purchases] | all platforms", "expected", 27, "actual", CALCULATE ( [Purchases] ), "tol", 0 ),
ROW ( "check_id", 18, "measure", "[Payer Rate] | all platforms", "expected", 0.001779, "actual", CALCULATE ( [Payer Rate] ), "tol", 1e-06 ),
ROW ( "check_id", 19, "measure", "[ARPU] | all platforms", "expected", 0.002099, "actual", CALCULATE ( [ARPU] ), "tol", 1e-06 ),
ROW ( "check_id", 20, "measure", "[ARPDAU] | all platforms", "expected", 0.00054, "actual", CALCULATE ( [ARPDAU] ), "tol", 1e-06 ),
ROW ( "check_id", 21, "measure", "[ARPPU] | all platforms", "expected", 1.1799, "actual", CALCULATE ( [ARPPU] ), "tol", 0.0001 ),
ROW ( "check_id", 22, "measure", "[Payer Rate] | platform=ANDROID", "expected", 0.001484, "actual", CALCULATE ( [Payer Rate], dim_platform[platform] = "ANDROID" ), "tol", 1e-06 ),
ROW ( "check_id", 23, "measure", "[Payer Rate] | platform=IOS", "expected", 0.002061, "actual", CALCULATE ( [Payer Rate], dim_platform[platform] = "IOS" ), "tol", 1e-06 ),
ROW ( "check_id", 24, "measure", "[LTV D7] | none", "expected", 0.002701, "actual", CALCULATE ( [LTV D7] ), "tol", 1e-06 ),
ROW ( "check_id", 25, "measure", "[LTV D30] | none", "expected", 0.002701, "actual", CALCULATE ( [LTV D30] ), "tol", 1e-06 ),
ROW ( "check_id", 26, "measure", "[Reach Rate] | level=10", "expected", 0.2784, "actual", CALCULATE ( [Reach Rate], fact_level_funnel[level] = 10 ), "tol", 0.0001 ),
ROW ( "check_id", 27, "measure", "[Reach Rate] | level=30", "expected", 0.0784, "actual", CALCULATE ( [Reach Rate], fact_level_funnel[level] = 30 ), "tol", 0.0001 ),
ROW ( "check_id", 28, "measure", "[Completion per Attempt] | level=27", "expected", 0.0447, "actual", CALCULATE ( [Completion per Attempt], fact_level_funnel[level] = 27 ), "tol", 0.0001 ),
ROW ( "check_id", 29, "measure", "[Quit Rate] | level=27", "expected", 0.4574, "actual", CALCULATE ( [Quit Rate], fact_level_funnel[level] = 27 ), "tol", 0.0001 ),
ROW ( "check_id", 30, "measure", "[Attempts per Player] | level=27", "expected", 9.07, "actual", CALCULATE ( [Attempts per Player], fact_level_funnel[level] = 27 ), "tol", 0.005 ),
ROW ( "check_id", 31, "measure", "[Segment D7 Retention] | dimension='Day-0 engagement time', segment='<1 min'", "expected", 0.0226, "actual", CALCULATE ( [Segment D7 Retention], fact_day0_segments[dimension] = "Day-0 engagement time", fact_day0_segments[segment] = "<1 min" ), "tol", 0.0001 ),
ROW ( "check_id", 32, "measure", "[Segment D7 Retention] | dimension='Day-0 engagement time', segment='15+ min'", "expected", 0.12, "actual", CALCULATE ( [Segment D7 Retention], fact_day0_segments[dimension] = "Day-0 engagement time", fact_day0_segments[segment] = "15+ min" ), "tol", 0.0001 ),
ROW ( "check_id", 33, "measure", "[Segment D1 Retention] | dimension='Day-0 game mode', segment='both'", "expected", 0.2909, "actual", CALCULATE ( [Segment D1 Retention], fact_day0_segments[dimension] = "Day-0 game mode", fact_day0_segments[segment] = "both" ), "tol", 0.0001 ),
ROW ( "check_id", 34, "measure", "[Test AUC] | model=logistic_regression", "expected", 0.6826, "actual", CALCULATE ( [Test AUC], fact_churn_model_performance[model] = "logistic_regression" ), "tol", 0.0001 ),
ROW ( "check_id", 35, "measure", "[Test AUC] | model=decision_tree", "expected", 0.6023, "actual", CALCULATE ( [Test AUC], fact_churn_model_performance[model] = "decision_tree" ), "tol", 0.0001 ),
ROW ( "check_id", 36, "measure", "[Decile Churn Rate] | risk_decile=10", "expected", 0.8649, "actual", CALCULATE ( [Decile Churn Rate], fact_churn_risk_deciles[risk_decile] = 10 ), "tol", 0.0001 ),
ROW ( "check_id", 37, "measure", "[Decile Churn Rate] | risk_decile=1", "expected", 0.5135, "actual", CALCULATE ( [Decile Churn Rate], fact_churn_risk_deciles[risk_decile] = 1 ), "tol", 0.0001 ),
ROW ( "check_id", 38, "measure", "rate_a | comparison='Platform: iOS vs Android', metric='D1 retention'", "expected", 0.1895, "actual", CALCULATE ( MAX ( fact_ab_observational_tests[rate_a] ), fact_ab_observational_tests[comparison] = "Platform: iOS vs Android", fact_ab_observational_tests[metric] = "D1 retention" ), "tol", 0.0001 ),
ROW ( "check_id", 39, "measure", "rate_b | comparison='Platform: iOS vs Android', metric='D1 retention'", "expected", 0.2269, "actual", CALCULATE ( MAX ( fact_ab_observational_tests[rate_b] ), fact_ab_observational_tests[comparison] = "Platform: iOS vs Android", fact_ab_observational_tests[metric] = "D1 retention" ), "tol", 0.0001 ),
ROW ( "check_id", 40, "measure", "n_per_arm | mde_abs=0.02", "expected", 6834, "actual", CALCULATE ( MAX ( fact_ab_power_analysis[n_per_arm] ), FILTER ( ALL ( fact_ab_power_analysis[mde_abs] ), ROUND ( fact_ab_power_analysis[mde_abs], 6 ) = 0.02 ) ), "tol", 0 )
)
RETURN SELECTCOLUMNS ( t, "check_id", [check_id], "measure", [measure], "expected", [expected], "actual", [actual], "abs_diff", ABS ( [actual] - [expected] ), "result", IF ( NOT ISBLANK ( [actual] ) && ABS ( [actual] - [expected] ) <= [tol] + 1e-12, "PASS", "FAIL" ) )
ORDER BY [check_id]