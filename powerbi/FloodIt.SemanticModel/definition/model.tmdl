model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_ProTooling = ["DevMode","MCP-PBIModeling"]

annotation PBI_QueryOrder = ["fact_daily_activity","dim_date","dim_platform","fact_retention_cohort","fact_retention_curve","fact_retention_platform","fact_monetization_platform","fact_iap_transactions","fact_ltv_curve","fact_level_funnel","fact_quickplay_boards","fact_level_anomalies","fact_day0_segments","fact_payer_profile","fact_churn_model_performance","fact_churn_feature_importance","fact_churn_roc","fact_churn_risk_deciles","fact_ab_observational_tests","fact_ab_power_analysis","fact_event_catalog","fact_user_acquisition_segments","fact_traffic_source_platform","fact_spike_event_mix","kpi_metrics","CsvFolder"]

