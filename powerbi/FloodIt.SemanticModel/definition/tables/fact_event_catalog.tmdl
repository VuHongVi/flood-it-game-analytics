	partition fact_event_catalog = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(CsvFolder & "fact_event_catalog.csv"), [Delimiter=",", Columns=8, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"event_name", type text}, {"events_android", Int64.Type}, {"events_ios", Int64.Type}, {"users_android", Int64.Type}, {"users_ios", Int64.Type}, {"events_total", Int64.Type}, {"share_of_events", type number}, {"platform_coverage", type text}}, "en-US")
				in
				    Typed

