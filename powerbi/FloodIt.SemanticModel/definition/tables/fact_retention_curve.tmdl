				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"day_n", Int64.Type}, {"cohort_users", Int64.Type}, {"eligible_users", Int64.Type}, {"retained_users", Int64.Type}, {"retention", type number}, {"ci_low", type number}, {"ci_high", type number}}, "en-US")
