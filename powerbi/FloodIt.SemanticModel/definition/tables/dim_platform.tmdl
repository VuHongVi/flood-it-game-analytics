table dim_platform
	lineageTag: 3fa4d4d6-f74f-445c-9a3e-739da8a1835c

	column platform
		dataType: string
		lineageTag: 7adec8ee-3c0a-4de1-bf04-19e930d7750a
		sourceColumn: platform

	partition dim_platform = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(CsvFolder & "dim_platform.csv"), [Delimiter=",", Columns=1, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"platform", type text}}, "en-US")
				in
				    Typed

