table fact_churn_roc
	lineageTag: 6fcefdc8-8c7e-4d12-81b6-bb659f18b96b

	column model
		dataType: string
		lineageTag: 0156b35f-6cc1-4736-bf6d-0aafe93513d9
		sourceColumn: model

	column fpr
		dataType: double
		formatString: 0.00
		lineageTag: 10c79c55-891b-4378-a1a2-aa2c6441c9a8
		sourceColumn: fpr

	column tpr
		dataType: double
		formatString: 0.00
		lineageTag: 042a29f1-d623-415c-96ec-7916c0fc76f5
		sourceColumn: tpr

	partition fact_churn_roc = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(CsvFolder & "fact_churn_roc.csv"), [Delimiter=",", Columns=3, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"model", type text}, {"fpr", type number}, {"tpr", type number}}, "en-US")
				in
				    Typed

